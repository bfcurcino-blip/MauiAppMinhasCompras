<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppMinhasCompras.Views.NovoProduto"
    Title="NovoProduto"
    BackgroundColor="#F7F1E8">

    <VerticalStackLayout
        Padding="30"
        Spacing="15">

        <Label
            Text="Novo Produto"
            FontSize="24"
            FontAttributes="Bold"
            TextColor="#6E4A8E"
            HorizontalOptions="Center" />

        <Entry
            x:Name="txt_descricao"
            Placeholder="Descrição"
            BackgroundColor="#F1E6F7"
            TextColor="#3D3D3D"
            PlaceholderColor="#7A6A80" />

        <Entry
            x:Name="txt_categoria"
            Placeholder="Categoria"
            BackgroundColor="#F1E6F7"
            TextColor="#3D3D3D"
            PlaceholderColor="#7A6A80" />

        <Entry
            x:Name="txt_quantidade"
            Placeholder="Quantidade"
            Keyboard="Numeric"
            BackgroundColor="#F1E6F7"
            TextColor="#3D3D3D"
            PlaceholderColor="#7A6A80" />

        <Entry
            x:Name="txt_preco"
            Placeholder="Preço"
            Keyboard="Numeric"
            BackgroundColor="#F1E6F7"
            TextColor="#3D3D3D"
            PlaceholderColor="#7A6A80" />

        <Button
            Text="Salvar"
            BackgroundColor="#6B4F4F"
            TextColor="White"
            Clicked="ToolbarItem_Clicked" />

    </VerticalStackLayout>

</ContentPage>